# Copy this file to .env and fill in only the keys you own. Never commit .env.
#
# OpenPhish and Phishing.Database need no key at all: they download and cache
# themselves, so the scanner has live threat data on first run. Everything
# below is optional - a missing key shows as "Needs key", and the scan is
# reported as incomplete instead of being treated as safe.

# PhishTank - free app key from your own account: https://phishtank.org/developer_info.php
PHISHTANK_APP_KEY=

# URLhaus (abuse.ch) - free Auth-Key: https://auth.abuse.ch/
URLHAUS_AUTH_KEY=

# Google Safe Browsing - enable the API, then create a key:
# https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_KEY=
