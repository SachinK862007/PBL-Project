# Copy to .env and fill in only the sources you are authorised to use.
# Never commit real keys. Sources left empty are reported as "not checked",
# and a scan that could not reach a source is always shown as incomplete.

# Google Safe Browsing v4 API key
GOOGLE_SAFE_BROWSING_KEY=

# URLhaus API authentication key (https://urlhaus.abuse.ch/api/)
URLHAUS_AUTH_KEY=

# Optional phishing feed URLs (plain-text, one URL per line)
PHISHTANK_FEED=
OPENPHISH_FEED=
